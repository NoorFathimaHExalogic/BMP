<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    controllerName="rak.zp02.controller.step1.ProjectSelection"
    displayBlock="true">

    <Page id="pageStep1" enableScrolling="true" class="rakPage rakApp">

        <!-- RAK App Header -->
        <customHeader>
            <Bar class="rakHeader sapMBarMiddle">
                <contentLeft>
                    <core:HTML content="&lt;div class='rakHeader__logo-area'&gt;&lt;img class='rakHeader__logo' src='assets/figma/step1/rak-municipality-logo.svg' alt='RAK Municipality' /&gt;&lt;div class='rakHeader__divider'&gt;&lt;/div&gt;&lt;img class='rakHeader__wordmark' src='assets/figma/step1/rak-digital-wordmark.svg' alt='RAK Digital' /&gt;&lt;/div&gt;" />
                </contentLeft>
                <contentRight>
                    <core:HTML content="&lt;div class='rakHeader__user-area'&gt;&lt;img class='rakHeader__avatar' src='assets/figma/step1/icon-user-avatar-small.svg' alt='User' /&gt;&lt;span class='rakHeader__user-name'&gt;Mohammed Al Rashid&lt;/span&gt;&lt;img class='rakHeader__chevron' src='assets/figma/step1/icon-chevron-down-small.svg' alt='' /&gt;&lt;/div&gt;" />
                </contentRight>
            </Bar>
        </customHeader>

        <!-- Fixed Footer with Next button -->
        <footer>
            <Bar class="rakFooter sapMBarMiddle">
                <contentRight>
                    <Button
                        id="btnNext"
                        text="{i18n>actionNext}"
                        press=".onNext"
                        enabled="{= !!${view>/selectedProjectId} }"
                        type="Emphasized"
                        class="rakNextBtn" />
                </contentRight>
            </Bar>
        </footer>

        <content>
            <!-- Permit heading row (HTML for full layout control) -->
            <core:HTML id="permitHeading" content="{view>/permitHeadingHtml}" />

            <!-- Stepper indicator (HTML for complex horizontal layout) -->
            <core:HTML id="stepper" content="{view>/stepperHtml}" />

            <!-- Section card white box -->
            <core:HTML id="sectionHeader" content="{view>/sectionHeaderHtml}" />

            <!-- Filter row -->
            <HBox id="filterRow" class="rakFilters rakContent" alignItems="Center"
                  justifyContent="SpaceBetween">
                <items>
                    <HBox class="rakFilters__dropdowns" alignItems="Center">
                        <items>
                            <Select id="selRole"
                                width="220px"
                                class="rakSelect"
                                selectedKey="{view>/filters/role}"
                                change=".onFilterChange"
                                items="{view>/roleOptions}">
                                <core:Item key="{view>key}" text="{view>text}" />
                            </Select>
                            <Select id="selStatus"
                                width="160px"
                                class="rakSelect"
                                selectedKey="{view>/filters/status}"
                                change=".onFilterChange"
                                items="{view>/statusOptions}">
                                <core:Item key="{view>key}" text="{view>text}" />
                            </Select>
                            <Select id="selDate"
                                width="160px"
                                class="rakSelect"
                                selectedKey="{view>/filters/date}"
                                change=".onFilterChange"
                                items="{view>/dateOptions}">
                                <core:Item key="{view>key}" text="{view>text}" />
                            </Select>
                        </items>
                    </HBox>
                    <SearchField
                        id="sfSearch"
                        width="279px"
                        placeholder="{i18n>step1SearchPlaceholder}"
                        value="{view>/filters/search}"
                        search=".onSearch"
                        liveChange=".onSearchLiveChange"
                        class="rakSearch" />
                </items>
            </HBox>

            <!-- Result count -->
            <Text id="resultCount"
                text="{= ${view>/resultCount} + ' results found'}"
                class="rakResultCount rakContent" />

            <!-- Project cards -->
            <List id="projectList"
                mode="None"
                showSeparators="None"
                noDataText="{i18n>step1NoResults}"
                items="{view>/displayedProjects}"
                class="rakContent rakProjectList">
                <CustomListItem
                    type="Active"
                    press=".onCardPress">
                    <content>
                        <VBox width="100%">
                            <!-- Row 1: Project no + date -->
                            <HBox class="rakCard__row" justifyContent="SpaceBetween" width="100%">
                                <items>
                                    <Text class="rakCard__project-no" text="{view>projectNumber}" />
                                    <Text class="rakCard__date" text="{view>createdOn}" />
                                </items>
                            </HBox>
                            <!-- Row 2: Meta groups + address + status + link -->
                            <HBox class="rakCard__row" alignItems="Center" justifyContent="SpaceBetween" width="100%">
                                <items>
                                    <HBox class="rakCard__meta-group" alignItems="Start">
                                        <items>
                                            <VBox class="rakCard__meta-item">
                                                <items>
                                                    <Text class="rakCard__meta-label" text="{i18n>step1LabelParcel}" />
                                                    <Text class="rakCard__meta-value" text="{view>parcelId}" />
                                                </items>
                                            </VBox>
                                            <VBox class="rakCard__meta-item">
                                                <items>
                                                    <Text class="rakCard__meta-label" text="{i18n>step1LabelOwner}" />
                                                    <Text class="rakCard__meta-value" text="{view>ownerName}" />
                                                </items>
                                            </VBox>
                                        </items>
                                    </HBox>
                                    <Text class="rakCard__address" text="{view>address}" />
                                    <HBox class="rakCard__right" alignItems="Center">
                                        <items>
                                            <core:HTML
                                                content="{= '&lt;span class=&quot;rakCard__status rakCard__status--' + ${view>statusCode} + '&quot;&gt;' + ${view>statusText} + '&lt;/span&gt;'}" />
                                            <Link
                                                text="{i18n>step1DetailLink}"
                                                press=".onFullDetails"
                                                class="rakCard__detail-link" />
                                        </items>
                                    </HBox>
                                </items>
                            </HBox>
                        </VBox>
                    </content>
                </CustomListItem>
            </List>

            <!-- Pagination -->
            <core:HTML id="pagination" content="{view>/paginationHtml}" />

            <!-- Footer spacer -->
            <core:HTML content="&lt;div style='height:80px'&gt;&lt;/div&gt;" />
        </content>

    </Page>

</mvc:View>
