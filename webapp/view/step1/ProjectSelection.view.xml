<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:rak="rak.zp02.control"
    controllerName="rak.zp02.controller.step1.ProjectSelection"
    displayBlock="true">

    <Page id="pageStep1" enableScrolling="true" class="rakPage rakApp">

        <!-- RAK Application Header -->
        <customHeader>
            <Bar class="rakHeader sapMBarMiddle">
                <contentLeft>
                    <core:HTML content="&lt;div class='rakHeader__logo-area'&gt;&lt;img class='rakHeader__logo' src='assets/figma/step1/rak-municipality-logo.svg' alt='RAK Municipality' /&gt;&lt;div class='rakHeader__divider'&gt;&lt;/div&gt;&lt;img class='rakHeader__wordmark' src='assets/figma/step1/rak-digital-wordmark.svg' alt='RAK Digital' /&gt;&lt;/div&gt;" />
                </contentLeft>
                <contentRight>
                    <core:HTML content="&lt;div class='rakHeader__user-area'&gt;&lt;img class='rakHeader__avatar' src='assets/figma/step1/icon-user-avatar-small.svg' alt='User' /&gt;&lt;span class='rakHeader__user-name'&gt;Abdullah Al-Aziz&lt;/span&gt;&lt;img class='rakHeader__chevron' src='assets/figma/step1/icon-chevron-down-small.svg' alt='' /&gt;&lt;/div&gt;" />
                </contentRight>
            </Bar>
        </customHeader>

        <!-- Footer with Next button -->
        <footer>
            <Bar class="rakFooter sapMBarMiddle">
                <contentRight>
                    <Button
                        id="btnNext"
                        text="{i18n>actionNext}"
                        press=".onNext"
                        enabled="{= !!${view>/selectedProjectId} }"
                        type="Emphasized"
                        class="rakNextBtn" />
                </contentRight>
            </Bar>
        </footer>

        <content>

            <!-- Permit heading: title + Save as Draft + Delete -->
            <HBox class="rakPermitHeading rakContent" alignItems="Center" justifyContent="SpaceBetween">
                <items>
                    <HBox alignItems="Center" class="rakPermitHeading__left">
                        <items>
                            <Image src="assets/figma/step1/icon-permit-muni-30.svg"
                                width="24px" height="24px"
                                class="rakPermitHeading__icon"
                                alt="New Building Permit" />
                            <Title text="New Building Permit"
                                titleStyle="H4"
                                class="rakPermitHeading__title" />
                        </items>
                    </HBox>
                    <HBox alignItems="Center" class="rakPermitHeading__actions">
                        <items>
                            <Button id="btnSaveDraft"
                                text="{i18n>actionSaveAsDraft}"
                                icon="sap-icon://save"
                                press=".onSaveAsDraft"
                                type="Transparent"
                                class="rakPermitAction" />
                            <Button id="btnDelete"
                                text="{i18n>actionDelete}"
                                icon="sap-icon://delete"
                                press=".onDelete"
                                type="Transparent"
                                class="rakPermitAction" />
                        </items>
                    </HBox>
                </items>
            </HBox>

            <!-- Stepper: SAPUI5 custom control -->
            <rak:RakStepper
                id="rakStepper"
                activeStep="{view>/activeStep}"
                stepLabels="{view>/stepLabels}"
                extraSteps="2"
                class="rakContent rakStepperWrap" />

            <!-- Section card: title + description -->
            <VBox class="rakSectionCard rakContent">
                <items>
                    <Title text="{i18n>step1SectionTitle}" titleStyle="H5" class="rakSection__title" />
                    <Text text="{i18n>step1SectionDesc}" class="rakSection__desc" wrapping="true" />
                </items>
            </VBox>

            <!-- Filter row -->
            <HBox id="filterRow" class="rakFilters rakContent" alignItems="Center"
                  justifyContent="SpaceBetween">
                <items>
                    <HBox class="rakFilters__dropdowns" alignItems="Center">
                        <items>
                            <Select id="selRole"
                                width="180px"
                                class="rakSelect"
                                selectedKey="{view>/filters/role}"
                                change=".onFilterChange"
                                tooltip="{i18n>step1FilterRole}"
                                items="{path: 'view>/roleOptions', templateShareable: false}">
                                <core:Item key="{view>key}" text="{view>text}" />
                            </Select>
                            <Select id="selStatus"
                                width="180px"
                                class="rakSelect"
                                selectedKey="{view>/filters/status}"
                                change=".onFilterChange"
                                tooltip="{i18n>step1FilterStatus}"
                                items="{path: 'view>/statusOptions', templateShareable: false}">
                                <core:Item key="{view>key}" text="{view>text}" />
                            </Select>
                            <Select id="selDate"
                                width="160px"
                                class="rakSelect"
                                selectedKey="{view>/filters/date}"
                                change=".onFilterChange"
                                tooltip="{i18n>step1FilterDate}"
                                items="{path: 'view>/dateOptions', templateShareable: false}">
                                <core:Item key="{view>key}" text="{view>text}" />
                            </Select>
                        </items>
                    </HBox>
                    <SearchField
                        id="sfSearch"
                        width="240px"
                        placeholder="{i18n>step1SearchPlaceholder}"
                        value="{view>/filters/search}"
                        search=".onSearch"
                        liveChange=".onSearchLiveChange"
                        class="rakSearch" />
                </items>
            </HBox>

            <!-- Result count -->
            <Text id="resultCount"
                text="{parts: [{path: 'view>/resultCount'}, {path: 'view>/totalCount'}], formatter: '.formatResultCount'}"
                class="rakResultCount rakContent" />

            <!-- Project cards -->
            <List id="projectList"
                mode="None"
                showSeparators="None"
                noDataText="{i18n>step1NoResults}"
                items="{path: 'view>/displayedProjects', templateShareable: false}"
                class="rakContent rakProjectList">
                <CustomListItem
                    type="Active"
                    press=".onCardPress">
                    <content>
                        <VBox class="rakCardInner" width="100%">
                            <!-- Row 1: Project number + date (left) | Status badge (right) -->
                            <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="rakCard__row1">
                                <items>
                                    <HBox alignItems="Center">
                                        <items>
                                            <Text class="rakCard__project-no" text="Project no. {view>projectNumber}" />
                                            <Text class="rakCard__date-sep" text="   " />
                                            <Text class="rakCard__date" text="{view>createdOnDisplay}" />
                                        </items>
                                    </HBox>
                                    <core:HTML
                                        content="{= '&lt;span class=&quot;rakCard__status rakCard__status--' + ${view>statusCode} + '&quot;&gt;' + ${view>statusText} + '&lt;/span&gt;'}" />
                                </items>
                            </HBox>
                            <!-- Row 2: Parcel ID | Owner (inline) -->
                            <Text
                                class="rakCard__meta-inline"
                                text="{= 'Parcel ID ' + ${view>parcelId} + '   |   Owner ' + ${view>ownerName}}" />
                            <!-- Row 3: Address (left) | Full Details (right) -->
                            <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="rakCard__row3">
                                <items>
                                    <Text class="rakCard__address" text="{view>address}" />
                                    <HBox alignItems="Center" class="rakCard__detail-link-wrap">
                                        <items>
                                            <core:Icon src="sap-icon://detail-view" class="rakCard__detail-icon" />
                                            <Link text="{i18n>step1DetailLink}" press=".onFullDetails" class="rakCard__detail-link" />
                                        </items>
                                    </HBox>
                                </items>
                            </HBox>
                        </VBox>
                    </content>
                </CustomListItem>
            </List>

            <!-- Pagination — proper SAPUI5 controls, no global references -->
            <HBox id="paginationBar"
                class="rakPagination rakContent"
                visible="{= ${view>/totalPages} > 1 }"
                alignItems="Center"
                justifyContent="Center">
                <Button id="btnPageFirst"
                    icon="sap-icon://media-rewind"
                    type="Transparent"
                    class="rakPagBtn"
                    tooltip="First page"
                    enabled="{= ${view>/currentPage} > 1 }"
                    press=".onPageFirst" />
                <Button id="btnPagePrev"
                    icon="sap-icon://slim-arrow-left"
                    type="Transparent"
                    class="rakPagBtn"
                    tooltip="Previous page"
                    enabled="{= ${view>/currentPage} > 1 }"
                    press=".onPagePrev" />
                <HBox id="pageNums"
                    items="{path: 'view>/paginationPages', templateShareable: false}"
                    alignItems="Center">
                    <Button
                        text="{view>num}"
                        type="{= ${view>active} ? 'Emphasized' : 'Ghost' }"
                        class="rakPagBtn rakPagBtn--num"
                        press=".onPageNumPress" />
                </HBox>
                <Button id="btnPageNext"
                    icon="sap-icon://slim-arrow-right"
                    type="Transparent"
                    class="rakPagBtn"
                    tooltip="Next page"
                    enabled="{= ${view>/currentPage} &lt; ${view>/totalPages} }"
                    press=".onPageNext" />
                <Button id="btnPageLast"
                    icon="sap-icon://media-fast-forward"
                    type="Transparent"
                    class="rakPagBtn"
                    tooltip="Last page"
                    enabled="{= ${view>/currentPage} &lt; ${view>/totalPages} }"
                    press=".onPageLast" />
            </HBox>

            <!-- Footer spacer -->
            <core:HTML content="&lt;div style='height:80px'&gt;&lt;/div&gt;" />

        </content>
    </Page>

</mvc:View>
